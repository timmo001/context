{
  "name": "context",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "context": "./dist/context"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/context",
    "build:packages": "bun run --cwd packages/effect-context build",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "prettier --write \"src/**/*.ts\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "prepare": "effect-tsgo patch --typescript --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.7",
    "@timmo001/effect-context": "workspace:*",
    "@timmo001/effect-gh": "0.9.1",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@oxlint/plugins": "1.90.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "^1.3.13",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.5.3",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
