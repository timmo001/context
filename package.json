{
  "name": "context",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "context": "./dist/context"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/context",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@timmo001/effect-gh": "github:timmo001/effect-gh#b1bce7c9a1054af1acca5f2c719a82c3d2847b80",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.0",
    "@oxlint/plugins": "1.82.0",
    "@timmo001/oxlint-rules": "0.3.3",
    "@types/bun": "^1.3.13",
    "oxlint": "1.82.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@effect/language-service"
  ]
}
