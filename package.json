{
  "name": "context",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "context": "./dist/context"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/context",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"docs/astro.config.mjs\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "prepare": "effect-tsgo patch --typescript"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@timmo001/effect-gh": "github:timmo001/effect-gh#46e7efe4c888ebb62fd78ba7692e600bb0f43d05",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/tsgo": "0.46.0",
    "@oxlint/plugins": "1.85.0",
    "@timmo001/oxlint-rules": "0.3.6",
    "@types/bun": "^1.3.13",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.5.3",
    "typescript": "7.0.2"
  }
}
