{
  "name": "context",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "context": "./dist/context"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/context",
    "build:packages": "bun run --cwd packages/effect-context build",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "prettier --write \"{src,opencode-plugin/src}/**/*.ts\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\" \"docs/*.ts\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "format:check": "prettier --check \"{src,opencode-plugin/src}/**/*.ts\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\" \"docs/*.ts\" \"docs/scripts/**/*.{ts,mjs}\" \"docs/src/**/*.{md,mdx,astro,css}\"",
    "prepare": "effect-tsgo patch --typescript --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.7",
    "@timmo001/effect-context": "workspace:*",
    "@timmo001/effect-gh": "0.14.1",
    "effect": "4.1.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.7",
    "@oxlint/plugins": "1.95.0",
    "@timmo001/oxlint-rules": "0.7.1",
    "@types/bun": "^1.3.13",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "^3.5.3",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
